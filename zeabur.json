{
  "$schema": "https://zeabur.com/schema.json",
  "name": "brightdata-mcp",
  "description": "Custom Bright Data MCP server with 17 tools (scraping, SERP, web unlocker, browser automation, proxy). Exposed over HTTP/SSE for remote MCP clients.",
  "template": "docker",
  "spec": {
    "port": 8080,
    "env": {
      "BRIGHTDATA_API_TOKEN": {
        "default": "",
        "required": true
      },
      "SERP_ZONE": {
        "default": "serp_api1",
        "required": true
      },
      "WEB_UNLOCKER_ZONE": {
        "default": "unlocker",
        "required": true
      },
      "BROWSER_ZONE": {
        "default": "browser_api1",
        "required": true
      },
      "BRIGHTDATA_CUSTOMER_ID": {
        "default": "",
        "required": false
      },
      "BRIGHTDATA_PROXY_PASSWORD": {
        "default": "",
        "required": false
      },
      "BRIGHTDATA_PROXY_ZONE": {
        "default": "residential",
        "required": false
      },
      "MCP_TRANSPORT": {
        "default": "http",
        "required": false
      },
      "MCP_HOST": {
        "default": "0.0.0.0",
        "required": false
      },
      "MCP_PORT": {
        "default": "8080",
        "required": false
      },
      "MCP_PATH": {
        "default": "/mcp",
        "required": false
      }
    }
  }
}
