# ════════════════════════════════════════════════════════════════
# REQUIRED — Bright Data API key (used as Bearer token in Authorization header)
# The key is a long opaque string with no fixed prefix — it does NOT start
# with "brd_". That prefix only appears in proxy-protocol usernames.
# Get it from: https://brightdata.com/cp/setting/users → "Add API key"
# (BRIGHTDATA_API_TOKEN is kept as a legacy alias)
# ════════════════════════════════════════════════════════════════
BRIGHTDATA_API_KEY=your_api_key_here

# ════════════════════════════════════════════════════════════════
# REQUIRED for SERP and Web Unlocker tools
# Zone names must match zones configured in your Bright Data dashboard.
# Get them from: https://brightdata.com/cp/zones
# Defaults below are Bright Data's standard zone names for the free pool.
# ════════════════════════════════════════════════════════════════
SERP_ZONE=serp_api1
WEB_UNLOCKER_ZONE=mcp_unlocker

# ════════════════════════════════════════════════════════════════
# MCP transport configuration
# - stdio: default for local Claude Desktop / Cursor / Claude Code
# - http:  for Zeabur deployment and remote MCP clients
# - sse:   legacy SSE transport
# ════════════════════════════════════════════════════════════════
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/mcp
