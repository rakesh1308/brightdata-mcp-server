# Bright Data API Token (required)
# Get it from: https://brightdata.com/cp/settings/api
BRIGHTDATA_API_TOKEN=your_api_key_here

# Zone names (must match zones configured in your Bright Data dashboard)
SERP_ZONE=serp_api1
WEB_UNLOCKER_ZONE=unlocker
BROWSER_ZONE=browser_api1

# Proxy credentials (for proxy_request tool)
# Get from: Bright Data Dashboard → Proxies & Infra → Access details
BRIGHTDATA_CUSTOMER_ID=your_customer_id
BRIGHTDATA_PROXY_PASSWORD=your_proxy_password

# Transport (stdio or sse) — stdio is default for Claude/Cursor
MCP_TRANSPORT=stdio
