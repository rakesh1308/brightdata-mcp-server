# ════════════════════════════════════════════════════════════════
# REQUIRED — Bright Data API authentication
# Get it from: https://brightdata.com/cp/settings/api
# ════════════════════════════════════════════════════════════════
BRIGHTDATA_API_TOKEN=your_api_key_here

# ════════════════════════════════════════════════════════════════
# REQUIRED for SERP, Web Unlocker, Browser API
# These zone names must match zones configured in your Bright Data dashboard.
# Get them from: https://brightdata.com/cp/zones
# ════════════════════════════════════════════════════════════════
SERP_ZONE=serp_api1
WEB_UNLOCKER_ZONE=unlocker
BROWSER_ZONE=browser_api1

# ════════════════════════════════════════════════════════════════
# REQUIRED for proxy_request tool
# Get from: Bright Data Dashboard → Proxies & Infra → Access details
# ════════════════════════════════════════════════════════════════
BRIGHTDATA_CUSTOMER_ID=your_customer_id
BRIGHTDATA_PROXY_PASSWORD=your_proxy_password

# ════════════════════════════════════════════════════════════════
# MCP transport configuration
# - stdio: default for local Claude Desktop / Cursor / Claude Code
# - http:  for Zeabur deployment and remote MCP clients
# - sse:   legacy SSE transport
# ════════════════════════════════════════════════════════════════
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/mcp
